let voiceEnabled = true;
let currentTypingDiv = null; // Track the current bot typing div

// Speak text using browser TTS
function speak(text) {
    if (!voiceEnabled) return;
    if (!window.speechSynthesis) return;
    const speech = new SpeechSynthesisUtterance(text);
    speech.lang = "en-US";
    window.speechSynthesis.speak(speech);
}

// Add message to chat box
function addMessage(type, text, isTyping = false) {
    const chatBox = document.getElementById("chatBox");
    const div = document.createElement("div");
    div.className = `message ${type}`;
    if (isTyping) {
        div.classList.add("typing");
        div.innerHTML = `<span class="dot"></span><span class="dot"></span><span class="dot"></span>`;
    } else {
        div.textContent = text;
    }
    chatBox.appendChild(div);
    chatBox.scrollTop = chatBox.scrollHeight;
    return div;
}

// Send user question to backend
function sendQuestion() {
    const input = document.getElementById("userInput");
    const question = input.value.trim();
    if (!question) return;

    addMessage("user", question);
    input.value = "";
    input.focus();

    // Show typing animation
    currentTypingDiv = addMessage("bot", "", true);

    fetch("/ask", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question: question })
    })
    .then(res => res.json())
    .then(data => {
        if (currentTypingDiv) currentTypingDiv.remove();
        currentTypingDiv = null;
        addMessage("bot", data.answer);
        speak(data.answer);
    })
    .catch(err => {
        if (currentTypingDiv) currentTypingDiv.remove();
        currentTypingDiv = null;
        addMessage("bot", "Server error. Try again.");
        console.error(err);
    });
}

// Start voice recognition
function startVoice() {
    const SpeechRecognition =
        window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
        alert("Speech recognition not supported in this browser");
        return;
    }

    const recognition = new SpeechRecognition();
    recognition.lang = "en-US";

    recognition.onresult = function (event) {
        document.getElementById("userInput").value =
            event.results[0][0].transcript;
        sendQuestion();
    };

    recognition.start();
}

// DOM events
document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("userInput");

    // Enter key support
    input.addEventListener("keydown", function (e) {
        if (e.key === "Enter") sendQuestion();
    });

    // Voice toggle button
    const voiceBtn = document.getElementById("voiceToggle");
    if (voiceBtn) {
        voiceBtn.addEventListener("click", function () {
            voiceEnabled = !voiceEnabled;
            voiceBtn.textContent = voiceEnabled ? "🎤 ON" : "🎤 OFF";
        });
    }

    // Dark mode toggle
    const modeBtn = document.getElementById("modeToggle");
    if (modeBtn) {
        modeBtn.addEventListener("click", function () {
            document.body.classList.toggle("dark-mode");
            modeBtn.textContent = document.body.classList.contains("dark-mode") ? "☀️ Light" : "🌙 Dark";
        });
    }

    // Stop button
    const stopBtn = document.getElementById("stopBtn");
    if (stopBtn) {
        stopBtn.addEventListener("click", () => {
            // Stop typing animation
            if (currentTypingDiv) {
                currentTypingDiv.remove();
                currentTypingDiv = null;
            }

            // Stop speech
            if (window.speechSynthesis) {
                window.speechSynthesis.cancel();
            }
        });
    }
});
