<!DOCTYPE html>
<html>
<head>
    <title>OXALISS SCHOOL CHATBOT</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>

<div class="chat-container">
    <div class="chat-header">
        🎓 OXALISS SCHOOL CHATBOT
            <button id="modeToggle">🌙 Dark</button>
           <button id="voiceToggle" style="display:none;">🎤 ON</button>
           <button id="stopBtn">⏹ Stop</button>

    </div>

    <div class="chat-box" id="chatBox"></div>

    <div class="chat-input">
        <input
        type="text"
        id="userInput"
        placeholder="Ask about the school..."
        autocomplete="off"
        />

        <button onclick="startVoice()">🎤</button>
        <button onclick="sendQuestion()">➤</button>
    </div>
</div>

<script src="/static/script.js"></script>
</body>
</html>
